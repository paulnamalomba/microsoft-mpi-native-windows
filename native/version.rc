// VERSIONINFO for the native fork's shipped binaries (MSMPI_NATIVE builds only).
// Upstream msmpi.rc, mpiexec.rc and smpd.rc need the WDK common.ver and are not
// compiled by the public build. msmpi_native_version.h is generated by
// native/build.py from the candidate version and source commit.
// MSMPI_NATIVE_TARGET selects the binary: 1 msmpi.dll, 2 mpiexec.exe, 3 smpd.exe.

#include <winver.h>
#include "msmpi_native_version.h"

#if MSMPI_NATIVE_TARGET == 1
#define NATIVE_FILETYPE     VFT_DLL
#define NATIVE_DESCRIPTION  "MPI library (MS-MPI native Windows fork)"
#define NATIVE_INTERNAL     "msmpi"
#define NATIVE_ORIGINAL     "msmpi.dll"
#elif MSMPI_NATIVE_TARGET == 2
#define NATIVE_FILETYPE     VFT_APP
#define NATIVE_DESCRIPTION  "MPI application launcher (MS-MPI native Windows fork)"
#define NATIVE_INTERNAL     "mpiexec"
#define NATIVE_ORIGINAL     "mpiexec.exe"
#elif MSMPI_NATIVE_TARGET == 3
#define NATIVE_FILETYPE     VFT_APP
#define NATIVE_DESCRIPTION  "MPI process manager (MS-MPI native Windows fork)"
#define NATIVE_INTERNAL     "smpd"
#define NATIVE_ORIGINAL     "smpd.exe"
#else
#error MSMPI_NATIVE_TARGET must select msmpi.dll (1), mpiexec.exe (2) or smpd.exe (3)
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    MSMPI_NATIVE_FILEVERSION
 PRODUCTVERSION MSMPI_NATIVE_FILEVERSION
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      MSMPI_NATIVE_FILEFLAGS
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       NATIVE_FILETYPE
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "microsoft-mpi-native-windows (independent fork)"
            VALUE "FileDescription",  NATIVE_DESCRIPTION
            VALUE "FileVersion",      MSMPI_NATIVE_VERSION_STR
            VALUE "InternalName",     NATIVE_INTERNAL
            VALUE "LegalCopyright",   "Copyright (c) Microsoft Corporation. Licensed under the MIT License."
            VALUE "OriginalFilename", NATIVE_ORIGINAL
            VALUE "ProductName",      "MS-MPI native Windows fork"
            VALUE "ProductVersion",   MSMPI_NATIVE_PRODUCTVERSION_STR
            VALUE "Comments",         MSMPI_NATIVE_COMMENTS_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
